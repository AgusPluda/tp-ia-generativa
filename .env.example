# Copiar a .env (que NO se commitea) y ajustar los valores.

# Usuario administrador: crea el esquema, carga datos sintéticos e ingesta los PDFs.
POSTGRES_USER=gym_admin
POSTGRES_PASSWORD=cambiar_password
POSTGRES_DB=gym
POSTGRES_PORT=5432

# OBLIGATORIAS: AGENTE_RO_PASSWORD y GEMINI_API_KEY.
# Usuario de SOLO LECTURA que usa el agente. No usar comillas ni caracteres especiales en la clave:
# db/init/02_roles.sh la inserta dentro de un heredoc SQL. Si queda vacía, el rol agente_ro
# se crea con contraseña vacía.
AGENTE_RO_PASSWORD=cambiar_password_ro

# Credenciales del LLM / embeddings
GEMINI_API_KEY=
