# Copiar a .env (que NO se commitea) y ajustar los valores.

# Usuario administrador: crea el esquema, carga datos sintéticos e ingesta los PDFs.
POSTGRES_USER=gym_admin
POSTGRES_PASSWORD=cambiar_password
POSTGRES_DB=gym
POSTGRES_PORT=5432

